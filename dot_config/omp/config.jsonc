{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "final_space": true,
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╭─"
        } , 
        {
          "type": "path",
          "style": "plain",
          "template": "[{{ .Path }}]"
        },
        {
          "type": "git",
          "style": "plain",
          "template": "[{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}]",
          "options": {
             "fetch_status": true,
             "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "template": "󰧂",
          "foreground_templates": ["{{ if eq .Code 0 }}{{ else }}red{{ end }}"],
          "options": {
          "always_enabled": true
          }
        }
      ]
    }
  ]
}
